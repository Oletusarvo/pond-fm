{
  "name": "@pondfm",
  "version": "1.0.0",
  "description": "A music sharing platform with purely chronological feeds without algorithmic curation.",
  "main": "index.js",
  "scripts": {
    "dev:web": "npm run dev -w @pondfm/web",
    "dev:server": "npm run dev -w @pondfm/server",
    "build:web": "npm run build -w @pondfm/web",
    "build:server": "npm run build -w @pondfm/server",
    "start:server": "npm run start -w @pondfm/server",
    "start:tunnel:server": "cloudflared tunnel --url http://localhost:3002",
    "start:tunnel:upload": "cloudflared tunnel --url http://localhost:3003",
    "build:packages": "npm run build -w @pondfm/crypto && npm run build -w @pondfm/server-utils"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "author": "oletusarvo",
  "license": "ISC",
  "dependencies": {
    "multer": "^2.2.0"
  }
}
